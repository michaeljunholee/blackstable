{% extends "base.html.j2" %}
{% block title %}Explore — Stablecoin Blacklisting{% endblock %}
{% block head_extra %}
<link rel="stylesheet" href="assets/explore.css">
{% endblock %}
{% block content %}
<section class="explore">
  <h1>Explore: Search and filter all events</h1>
  <p class="lede">
    Filter the {{ actions|length }} freeze and unfreeze events. Paste an
    address into the search box to instantly see whether Circle has acted
    on it. Filter state is encoded in the URL — share a filtered view by
    copying the link.
  </p>

  <div class="search-bar">
    <label for="search-input">Search address or text</label>
    <input id="search-input" type="text" placeholder="0x… or text from descriptions / triggers" autocomplete="off">
  </div>

  <div class="filter-chips">
    <fieldset>
      <legend>Chain</legend>
      <label><input type="checkbox" name="chain" value="ethereum" checked> Ethereum</label>
      <label><input type="checkbox" name="chain" value="base" checked> Base</label>
      <label><input type="checkbox" name="chain" value="polygon" checked> Polygon</label>
      <label><input type="checkbox" name="chain" value="avalanche" checked> Avalanche</label>
      <label><input type="checkbox" name="chain" value="arbitrum" checked> Arbitrum</label>
      <label><input type="checkbox" name="chain" value="optimism" checked> Optimism</label>
    </fieldset>

    <fieldset>
      <legend>Mechanism</legend>
      <label><input type="checkbox" name="mechanism_type" value="BLACKLIST" checked> Blacklist</label>
      <label><input type="checkbox" name="mechanism_type" value="UNBLACKLIST" checked> Unblacklist</label>
    </fieldset>

    <fieldset>
      <legend>Status</legend>
      <label><input type="checkbox" name="status" value="ACTIVE" checked> Active</label>
      <label><input type="checkbox" name="status" value="REVERSED" checked> Reversed</label>
    </fieldset>

    <fieldset>
      <legend>Confidence</legend>
      <label><input type="checkbox" name="confidence" value="HIGH" checked> High</label>
      <label><input type="checkbox" name="confidence" value="MEDIUM" checked> Medium</label>
      <label><input type="checkbox" name="confidence" value="LOW" checked> Low</label>
    </fieldset>

    <fieldset>
      <legend>Date range</legend>
      <label>From <input type="date" name="date_from"></label>
      <label>To <input type="date" name="date_to"></label>
    </fieldset>
  </div>

  <div class="result-summary">
    <span id="result-count">{{ actions|length }}</span> events match
    (<span id="bl-count">—</span> blacklist, <span id="ub-count">—</span> unblacklist)
  </div>

  <div class="result-table-wrapper">
    <table class="result-table" id="results">
      <thead>
        <tr>
          <th data-sort-key="action_date">Date</th>
          <th data-sort-key="mechanism_type">Mechanism</th>
          <th data-sort-key="chain">Chain</th>
          <th data-sort-key="target_identifier">Address</th>
          <th data-sort-key="trigger_id">Trigger</th>
          <th data-sort-key="status">Status</th>
          <th data-sort-key="confidence">Confidence</th>
        </tr>
      </thead>
      <tbody id="results-body">
        <!-- populated by explore.js -->
      </tbody>
    </table>
    <p class="result-table-note">Showing first 500 rows. Refine filters to narrow the set.</p>
  </div>
</section>

<script src="assets/explore.js"></script>
{% endblock %}
